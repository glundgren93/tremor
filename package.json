{
  "name": "tremor",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-agnostic browser observation and chaos CLI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "cli": "node dist/cli/main.mjs"
  },
  "dependencies": {
    "pino": "^9.14.0",
    "playwright": "^1.58.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/node": "^25.3.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright"
    ]
  },
  "bin": {
    "tremor": "./dist/cli/main.mjs"
  }
}
